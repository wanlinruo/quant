# 复制为 .env 后填写；.env 不得提交到仓库
# 交易模式：sim / paper / live。Mac 本地只允许 sim 或 paper
TRADING_MODE=paper
# 老虎开发者中心导出的 tiger_openapi_config.properties 所在目录（文件权限 600，放在仓库外）
TIGER_PROPS_PATH=~/.config/quant/tiger/

# 可选：覆盖 configs/*.yaml 中的值，QUANT_ 前缀，嵌套用 __
# QUANT_EXECUTOR__CASH_BUFFER=0.02
# 密钥类（只放在 .env 或服务器环境变量中）
# QUANT_DATABASE_URL=postgresql+psycopg://quant:<password>@localhost:5432/quant
# 企业微信群机器人 webhook（含 key，属于密钥）；配置后用 uv run quant notify-test 检查
# QUANT_NOTIFY_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=<key>

# docker compose 中 postgres 的密码（必填，本地可用 openssl rand -hex 16 生成）
POSTGRES_PASSWORD=
